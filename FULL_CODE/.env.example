# CareBridge AI - Environment Configuration
# When running in DEMO mode, no API key is required.
# To connect to an active AI provider for model evaluation:

PORT=3001

# Gemini API Key (Optional - will use verified deterministic demo mode if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here
